# Site-specific values for the deploy scripts. Copy to deploy/site.env (git-ignored) and fill in.
# LAN address of the NAS (the Web UI is published on this address only)
NAS_IP=192.0.2.20
# LAN address of the INNR bridge (written into config.toml when a new config is created)
BRIDGE_IP=192.0.2.10
# lower-case GitHub user or organisation that owns the (private) container image ghcr.io/<owner>/innr-autooff
GHCR_OWNER=your-github-user
# ssh alias of the NAS from ~/.ssh/config
SERVER=myNAS

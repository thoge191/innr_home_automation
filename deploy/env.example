# Copy to .env next to compose.yaml (mode 600). Not secret, but environment specific.
# Comments on their own lines only (older compose versions do not strip inline comments).

# Registry owner of the image (lower-case GitHub user or organisation)
GHCR_OWNER=your-github-user
# Immutable image tag printed by deploy/build-push.sh
APP_TAG=sha-xxxxxxxx
# INNR account e-mail; the password goes to secrets/innr_password
INNR_EMAIL=you@example.com
# Web UI host address. Mac: 127.0.0.1   NAS: the LAN address of the NAS
WEB_BIND_IP=127.0.0.1
WEB_PORT=8480
LOG_LEVEL=INFO
